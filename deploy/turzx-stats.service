# A systemd user service. Copy to ~/.config/systemd/user/turzx-stats.service, then:
#   systemctl --user enable --now turzx-stats
#   sudo loginctl enable-linger "$USER"     # start at boot, without a login
[Unit]
Description=turzx-stats (TURZX 9.2 stats screen)

[Service]
ExecStart=%h/apps/turzx-stats/turzx-stats --interval 5 --brightness 60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
